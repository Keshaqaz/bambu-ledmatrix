BAMBU_CLOUD_TOKEN=''
# Refresh token for autonomous rotation. Populated automatically by
# install-cloud-token when the official login JSON contains a refreshToken,
# and rotated by refresh-cloud-token. Leave empty to disable auto-refresh
# (the cron check then falls back to manual rotation on expiry).
# BAMBU_CLOUD_REFRESH_TOKEN=''
# Managed automatically by admin.py when a complete login JSON with expiresIn
# is installed. Omit it when only a raw opaque access token is available.
# BAMBU_CLOUD_TOKEN_EXPIRES_AT=''
BAMBU_CLOUD_UID=''
BAMBU_PRINTER_SERIAL=''

# Optional auth for the relay HTTP endpoint.
BAMBU_RELAY_KEY=''

# HTTP bind settings for the relay.
BAMBU_RELAY_HOST='0.0.0.0'
BAMBU_RELAY_PORT='8787'

# Seconds without printer MQTT reports before /status degrades to unknown.
BAMBU_RELAY_STALE_SECONDS='70'

# Optional LAN mode. Leave empty when using cloud MQTT mode.
BAMBU_PRINTER_HOST=''
BAMBU_PRINTER_ACCESS_CODE=''

# Optional MQTT overrides.
BAMBU_MQTT_HOST='us.mqtt.bambulab.com'
BAMBU_MQTT_PORT='8883'
BAMBU_MQTT_USERNAME='bblp'
